[{"id":1,"termHe":"\u05EA\u05E2\u05D5\u05D3\u05EA \u05D6\u05D4\u05D5\u05EA","transliteration":"Te\u0027udat Zehut","meaning":"\u05EA\u05E2\u05D5\u05D3\u05EA \u05D6\u05D4\u05D5\u05EA. \u05DE\u05E1\u05DE\u05DA \u05E2\u05DD \u05DE\u05E1\u05E4\u05E8 \u05DE\u05D6\u05D4\u05D4 \u05D1\u05DF \u05EA\u05E9\u05E2 \u05E1\u05E4\u05E8\u05D5\u05EA \u05D4\u05DE\u05E9\u05DE\u05E9 \u05D1\u05E4\u05E0\u05D9\u05D9\u05D4 \u05DC\u05E8\u05E9\u05D5\u05D9\u05D5\u05EA \u05D5\u05DC\u05D2\u05D5\u05E4\u05D9\u05DD \u05D0\u05D7\u05E8\u05D9\u05DD.","usageNote":null},{"id":2,"termHe":"\u05DE\u05E1\u05E4\u05E8 \u05EA\u05D9\u05E7","transliteration":"Mispar Tik","meaning":"\u05DE\u05E1\u05E4\u05E8 \u05EA\u05D9\u05E7. \u05E6\u05D9\u05D9\u05E0\u05D5 \u05D0\u05D5\u05EA\u05D5 \u05D1\u05E4\u05E0\u05D9\u05D9\u05D4 \u05D1\u05E0\u05D5\u05D2\u05E2 \u05DC\u05DE\u05DB\u05EA\u05D1 \u05D0\u05D5 \u05DC\u05E0\u05D5\u05E9\u05D0 \u05DE\u05E1\u05D5\u05D9\u05DD.","usageNote":null},{"id":3,"termHe":"\u05D1\u05D9\u05D8\u05D5\u05D7 \u05DC\u05D0\u05D5\u05DE\u05D9","transliteration":"Bituach Leumi","meaning":"\u05D1\u05D9\u05D8\u05D5\u05D7 \u05DC\u05D0\u05D5\u05DE\u05D9. \u05D4\u05DE\u05D5\u05E1\u05D3 \u05DC\u05D1\u05D9\u05D8\u05D5\u05D7 \u05DC\u05D0\u05D5\u05DE\u05D9 \u05D1\u05D9\u05E9\u05E8\u05D0\u05DC, \u05D4\u05DE\u05D8\u05E4\u05DC \u05D1\u05D1\u05D9\u05D8\u05D5\u05D7 \u05E1\u05D5\u05E6\u05D9\u05D0\u05DC\u05D9 \u05D5\u05D1\u05E7\u05E6\u05D1\u05D0\u05D5\u05EA.","usageNote":null},{"id":4,"termHe":"\u05DE\u05E1 \u05D4\u05DB\u05E0\u05E1\u05D4","transliteration":"Mas Hachnasa","meaning":"\u05DE\u05E1 \u05D4\u05DB\u05E0\u05E1\u05D4. \u05DE\u05E1 \u05E2\u05DC \u05D4\u05DB\u05E0\u05E1\u05D5\u05EA; \u05D4\u05D1\u05D9\u05D8\u05D5\u05D9 \u05DE\u05E9\u05DE\u05E9 \u05D2\u05DD \u05DC\u05E6\u05D9\u05D5\u05DF \u05D4\u05D9\u05D7\u05D9\u05D3\u05D4 \u05D1\u05E8\u05E9\u05D5\u05EA \u05D4\u05DE\u05E1\u05D9\u05DD \u05D4\u05DE\u05D8\u05E4\u05DC\u05EA \u05D1\u05D5.","usageNote":null},{"id":5,"termHe":"\u05D3\u05E8\u05D9\u05E9\u05EA \u05EA\u05E9\u05DC\u05D5\u05DD","transliteration":"Drishat Tashlum","meaning":"\u05D3\u05E8\u05D9\u05E9\u05EA \u05EA\u05E9\u05DC\u05D5\u05DD. \u05D4\u05D5\u05D3\u05E2\u05D4 \u05E8\u05E9\u05DE\u05D9\u05EA \u05DC\u05E9\u05DC\u05DD \u05E1\u05DB\u05D5\u05DD \u05DE\u05E1\u05D5\u05D9\u05DD \u05E2\u05D3 \u05D4\u05DE\u05D5\u05E2\u05D3 \u05E9\u05E0\u05E7\u05D1\u05E2.","usageNote":null},{"id":6,"termHe":"\u05DE\u05D5\u05E2\u05D3 \u05D0\u05D7\u05E8\u05D5\u05DF","transliteration":"Moed Acharon","meaning":"\u05DE\u05D5\u05E2\u05D3 \u05D0\u05D7\u05E8\u05D5\u05DF. \u05D4\u05EA\u05D0\u05E8\u05D9\u05DA \u05D4\u05D0\u05D7\u05E8\u05D5\u05DF \u05DC\u05D1\u05D9\u05E6\u05D5\u05E2 \u05D4\u05E4\u05E2\u05D5\u05DC\u05D4 \u05E9\u05D1\u05DE\u05E1\u05DE\u05DA; \u05D4\u05E9\u05DC\u05DB\u05D5\u05EA \u05D4\u05D0\u05D9\u05D7\u05D5\u05E8 \u05EA\u05DC\u05D5\u05D9\u05D5\u05EA \u05D1\u05D4\u05DC\u05D9\u05DA.","usageNote":null},{"id":7,"termHe":"\u05E2\u05E8\u05E2\u05D5\u05E8","transliteration":"Erur","meaning":"\u05E2\u05E8\u05E2\u05D5\u05E8 \u05E2\u05DC \u05D4\u05D7\u05DC\u05D8\u05D4. \u05D9\u05E9 \u05DC\u05D1\u05D3\u05D5\u05E7 \u05D1\u05D4\u05D5\u05D3\u05E2\u05D4 \u05D0\u05EA \u05E1\u05D5\u05D2 \u05D4\u05D4\u05DC\u05D9\u05DA \u05D5\u05D0\u05EA \u05D4\u05DE\u05D5\u05E2\u05D3 \u05DC\u05D4\u05D2\u05E9\u05EA\u05D5; \u05D4\u05E9\u05D2\u05D4 \u05D5\u05E2\u05E8\u05E2\u05D5\u05E8 \u05E2\u05E9\u05D5\u05D9\u05D9\u05DD \u05DC\u05D4\u05D9\u05D5\u05EA \u05E9\u05DC\u05D1\u05D9\u05DD \u05E9\u05D5\u05E0\u05D9\u05DD.","usageNote":"\u05E9\u05DE\u05E8\u05D5 \u05D4\u05E2\u05EA\u05E7 \u05D5\u05D0\u05D9\u05E9\u05D5\u05E8 \u05D4\u05D2\u05E9\u05D4. \u05D1\u05D3\u05E7\u05D5 \u05D0\u05EA \u05D4\u05D4\u05DC\u05D9\u05DA \u05D4\u05E8\u05E9\u05DE\u05D9 \u05D5\u05D0\u05EA \u05D4\u05DE\u05D5\u05E2\u05D3 \u05D4\u05DE\u05EA\u05D0\u05D9\u05DD \u05DC\u05D4\u05D7\u05DC\u05D8\u05D4 \u05E9\u05E7\u05D9\u05D1\u05DC\u05EA\u05DD."},{"id":8,"termHe":"\u05D0\u05D9\u05E9\u05D5\u05E8","transliteration":"Ishur","meaning":"\u05D0\u05D9\u05E9\u05D5\u05E8. \u05DE\u05E1\u05DE\u05DA \u05D4\u05DE\u05E2\u05D9\u05D3 \u05E2\u05DC \u05DE\u05E2\u05DE\u05D3, \u05D6\u05DB\u05D0\u05D5\u05EA \u05D0\u05D5 \u05E4\u05E2\u05D5\u05DC\u05D4 \u05E9\u05D1\u05D5\u05E6\u05E2\u05D4, \u05D0\u05D5 \u05D4\u05D7\u05DC\u05D8\u05D4 \u05D4\u05DE\u05D0\u05E9\u05E8\u05EA \u05D1\u05E7\u05E9\u05D4.","usageNote":null},{"id":9,"termHe":"\u05D4\u05E1\u05D1\u05E8 \u05E0\u05DC\u05D5\u05D5\u05D4","transliteration":"Hesber Nilve","meaning":"\u05D4\u05E1\u05D1\u05E8 \u05E0\u05DC\u05D5\u05D5\u05D4. \u05D8\u05E7\u05E1\u05D8 \u05D0\u05D5 \u05E2\u05DE\u05D5\u05D3 \u05E0\u05D5\u05E1\u05E3 \u05D4\u05DE\u05E1\u05D1\u05D9\u05E8 \u05D7\u05D9\u05E9\u05D5\u05D1\u05D9\u05DD \u05D0\u05D5 \u05D4\u05D7\u05DC\u05D8\u05D5\u05EA \u05D1\u05DE\u05DB\u05EA\u05D1.","usageNote":null},{"id":10,"termHe":"\u05E1\u05E2\u05D9\u05E3","transliteration":"Sa\u0027if","meaning":"\u05E1\u05E2\u05D9\u05E3. \u05D7\u05DC\u05E7 \u05DE\u05DE\u05D5\u05E1\u05E4\u05E8 \u05D1\u05D7\u05D5\u05E7 \u05D0\u05D5 \u05D1\u05DE\u05E1\u05DE\u05DA.","usageNote":null},{"id":11,"termHe":"\u05EA\u05D5\u05E7\u05E3","transliteration":"Tokef","meaning":"\u05EA\u05D5\u05E7\u05E3. \u05D4\u05EA\u05E7\u05D5\u05E4\u05D4 \u05E9\u05D1\u05D4 \u05DE\u05E1\u05DE\u05DA, \u05D4\u05D9\u05EA\u05E8 \u05D0\u05D5 \u05D0\u05D9\u05E9\u05D5\u05E8 \u05EA\u05E7\u05E4\u05D9\u05DD.","usageNote":null},{"id":12,"termHe":"\u05E4\u05D8\u05D5\u05E8","transliteration":"Ptur","meaning":"\u05E4\u05D8\u05D5\u05E8. \u05E9\u05D7\u05E8\u05D5\u05E8 \u05DE\u05D7\u05D5\u05D1\u05D4, \u05DE\u05DE\u05E1 \u05D0\u05D5 \u05DE\u05D0\u05D2\u05E8\u05D4 \u05DE\u05E1\u05D5\u05D9\u05DE\u05D9\u05DD \u05D1\u05DB\u05E4\u05D5\u05E3 \u05DC\u05EA\u05E0\u05D0\u05D9\u05DD.","usageNote":null},{"id":13,"termHe":"\u05D4\u05D5\u05E6\u05D0\u05D4 \u05DC\u05E4\u05D5\u05E2\u05DC","transliteration":"Hotza\u0027a la-Po\u0027al","meaning":"\u05D4\u05D5\u05E6\u05D0\u05D4 \u05DC\u05E4\u05D5\u05E2\u05DC. \u05DE\u05E2\u05E8\u05DB\u05EA \u05DC\u05D0\u05DB\u05D9\u05E4\u05EA \u05E4\u05E1\u05E7\u05D9 \u05D3\u05D9\u05DF \u05D5\u05DC\u05D2\u05D1\u05D9\u05D9\u05EA \u05D7\u05D5\u05D1\u05D5\u05EA; \u05D0\u05DE\u05E6\u05E2\u05D9 \u05D4\u05D2\u05D1\u05D9\u05D9\u05D4 \u05EA\u05DC\u05D5\u05D9\u05D9\u05DD \u05D1\u05EA\u05D9\u05E7 \u05D5\u05D1\u05D3\u05D9\u05DF.","usageNote":"\u05D1\u05D3\u05E7\u05D5 \u05D0\u05EA \u05D4\u05E9\u05D5\u05DC\u05D7, \u05DE\u05E1\u05E4\u05E8 \u05D4\u05EA\u05D9\u05E7 \u05D5\u05D3\u05E8\u05DA \u05D4\u05DE\u05E2\u05E0\u05D4; \u05E4\u05E0\u05D5 \u05DC\u05E2\u05D6\u05E8\u05D4 \u05DE\u05E7\u05E6\u05D5\u05E2\u05D9\u05EA \u05DC\u05E4\u05D9 \u05D4\u05E6\u05D5\u05E8\u05DA."},{"id":14,"termHe":"\u05E8\u05D9\u05D1\u05D9\u05EA","transliteration":"Ribit","meaning":"\u05E8\u05D9\u05D1\u05D9\u05EA. \u05EA\u05D5\u05E1\u05E4\u05EA \u05D4\u05DE\u05D7\u05D5\u05E9\u05D1\u05EA \u05E2\u05DC \u05E1\u05DB\u05D5\u05DD \u05DB\u05E1\u05E3 \u05D1\u05D4\u05EA\u05D0\u05DD \u05DC\u05EA\u05E0\u05D0\u05D9\u05DD \u05D0\u05D5 \u05DC\u05DB\u05DC\u05DC\u05D9\u05DD \u05D4\u05D7\u05DC\u05D9\u05DD.","usageNote":null},{"id":15,"termHe":"\u05EA\u05E7\u05E0\u05D4","transliteration":"Takana","meaning":"\u05EA\u05E7\u05E0\u05D4. \u05DB\u05DC\u05DC \u05E9\u05E0\u05E7\u05D1\u05E2 \u05DE\u05DB\u05D5\u05D7 \u05D7\u05D5\u05E7 \u05D5\u05DC\u05E2\u05D9\u05EA\u05D9\u05DD \u05DE\u05E6\u05D5\u05D8\u05D8 \u05DC\u05E4\u05D9 \u05DE\u05E1\u05E4\u05E8\u05D5.","usageNote":null},{"id":16,"termHe":"\u05D7\u05D5\u05D1","transliteration":"Hov","meaning":"\u05D7\u05D5\u05D1. \u05E1\u05DB\u05D5\u05DD \u05E9\u05D4\u05E8\u05E9\u05D5\u05EA \u05E8\u05D5\u05D0\u05D4 \u05DB\u05D9\u05EA\u05E8\u05D4 \u05E9\u05DC\u05D0 \u05E9\u05D5\u05DC\u05DE\u05D4; \u05D1\u05D3\u05E7\u05D5 \u05D0\u05EA \u05DE\u05E8\u05DB\u05D9\u05D1\u05D9\u05D5 \u05D5\u05D0\u05EA \u05EA\u05E7\u05D5\u05E4\u05EA \u05D4\u05D7\u05D9\u05D5\u05D1.","usageNote":null},{"id":17,"termHe":"\u05E4\u05E8\u05D9\u05E1\u05EA \u05EA\u05E9\u05DC\u05D5\u05DE\u05D9\u05DD","transliteration":"Prisat Tashlumim","meaning":"\u05E4\u05E8\u05D9\u05E1\u05EA \u05EA\u05E9\u05DC\u05D5\u05DE\u05D9\u05DD. \u05D4\u05E1\u05D3\u05E8 \u05DE\u05D5\u05E1\u05DB\u05DD \u05DC\u05EA\u05E9\u05DC\u05D5\u05DD \u05D7\u05D5\u05D1 \u05D1\u05D7\u05DC\u05E7\u05D9\u05DD; \u05D4\u05EA\u05E0\u05D0\u05D9\u05DD \u05E2\u05E9\u05D5\u05D9\u05D9\u05DD \u05DC\u05DB\u05DC\u05D5\u05DC \u05E8\u05D9\u05D1\u05D9\u05EA.","usageNote":null},{"id":18,"termHe":"\u05D4\u05E9\u05DC\u05DE\u05EA \u05DE\u05E1\u05DE\u05DB\u05D9\u05DD","transliteration":"Hashlamat Mismachim","meaning":"\u05D4\u05E9\u05DC\u05DE\u05EA \u05DE\u05E1\u05DE\u05DB\u05D9\u05DD. \u05D4\u05D2\u05E9\u05EA \u05D0\u05E1\u05DE\u05DB\u05EA\u05D0\u05D5\u05EA \u05D7\u05E1\u05E8\u05D5\u05EA \u05D4\u05D3\u05E8\u05D5\u05E9\u05D5\u05EA \u05DC\u05D4\u05DE\u05E9\u05DA \u05D4\u05D8\u05D9\u05E4\u05D5\u05DC \u05D1\u05EA\u05D9\u05E7.","usageNote":null},{"id":19,"termHe":"\u05D4\u05D7\u05D6\u05E8 \u05DE\u05E1","transliteration":"Hekhzer Mas","meaning":"\u05D4\u05D7\u05D6\u05E8 \u05DE\u05E1. \u05D4\u05E9\u05D1\u05EA \u05E1\u05DB\u05D5\u05DD \u05E9\u05E8\u05E9\u05D5\u05EA \u05D4\u05DE\u05E1\u05D9\u05DD \u05E7\u05D1\u05E2\u05D4 \u05E9\u05E9\u05D5\u05DC\u05DD \u05D1\u05D9\u05EA\u05E8, \u05D1\u05DB\u05E4\u05D5\u05E3 \u05DC\u05E7\u05D9\u05D6\u05D5\u05D6\u05D9\u05DD \u05D4\u05E8\u05DC\u05D5\u05D5\u05E0\u05D8\u05D9\u05D9\u05DD.","usageNote":null},{"id":20,"termHe":"\u05D6\u05D9\u05DE\u05D5\u05DF \u05EA\u05D5\u05E8","transliteration":"Zimun Tor","meaning":"\u05D6\u05D9\u05DE\u05D5\u05DF \u05EA\u05D5\u05E8. \u05E7\u05D1\u05D9\u05E2\u05EA \u05DE\u05D5\u05E2\u05D3 \u05DC\u05D1\u05D9\u05E7\u05D5\u05E8 \u05D1\u05DC\u05E9\u05DB\u05D4 \u05D0\u05D5 \u05DC\u05E7\u05D1\u05DC\u05EA \u05E9\u05D9\u05E8\u05D5\u05EA.","usageNote":null}]