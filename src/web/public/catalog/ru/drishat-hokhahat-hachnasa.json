1\u05E0\u05E7, \u05D4\u05D5\u05D3\u05E2\u05D5\u05EA \u05E9\u05D5\u05DE\u05D4 \u05D5\u05D4\u05E2\u05D1\u05E8\u05EA \u05D4\u05D7\u05D6\u05E8. \u05E0\u05D1\u05D3\u05E7 \u05EA\u05D5\u05DB\u05DF \u05DE\u05D0\u05D5\u05E0\u05D3\u05E7\u05E1 \u05E9\u05DC \u05D4\u05D3\u05E3 \u05D4\u05E8\u05E9\u05DE\u05D9; \u05E4\u05EA\u05D9\u05D7\u05D4 \u05D0\u05D5\u05D8\u05D5\u05DE\u05D8\u05D9\u05EA \u05D9\u05E9\u05D9\u05E8\u05D4 \u05D4\u05D7\u05D6\u05D9\u05E8\u05D4 HTTP 403. \u05D6\u05D4\u05D5 \u05E8\u05E7\u05E2 \u05DC\u05D4\u05E1\u05D1\u05E8\u05D9\u05DD \u05E2\u05DC \u05D4\u05D7\u05D6\u05E8\u05D9\u05DD \u05D5\u05DE\u05E1\u05DE\u05DB\u05D9 \u05D4\u05DB\u05E0\u05E1\u05D4, \u05D5\u05DC\u05D0 \u05D0\u05D9\u05DE\u05D5\u05EA \u05E9\u05DC \u05D4\u05D5\u05D3\u05E2\u05D4 \u05DE\u05E1\u05D5\u05D9\u05DE\u05EA.","uk":"\u041E\u0444\u0456\u0446\u0456\u0439\u043D\u0430 \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044F \u043F\u0440\u043E \u043F\u043E\u0441\u043B\u0443\u0433\u0443: \u043F\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043D\u043D\u044F \u0434\u043E\u0445\u043E\u0434\u0443, \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u043A\u0430 \u0431\u0430\u043D\u043A\u0456\u0432\u0441\u044C\u043A\u043E\u0433\u043E \u0440\u0430\u0445\u0443\u043D\u043A\u0443, \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u0435\u043D\u043D\u044F \u043F\u0440\u043E \u043F\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0438\u0439 \u0440\u043E\u0437\u0440\u0430\u0445\u0443\u043D\u043E\u043A \u0456 \u043F\u0435\u0440\u0435\u043A\u0430\u0437 \u043F\u043E\u0432\u0435\u0440\u043D\u0435\u043D\u043D\u044F. \u041F\u0435\u0440\u0435\u0432\u0456\u0440\u0435\u043D\u043E \u0456\u043D\u0434\u0435\u043A\u0441\u043E\u0432\u0430\u043D\u0438\u0439 \u0432\u043C\u0456\u0441\u0442 \u043E\u0444\u0456\u0446\u0456\u0439\u043D\u043E\u0457 \u0441\u0442\u043E\u0440\u0456\u043D\u043A\u0438; \u043F\u0440\u044F\u043C\u0435 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0437\u043E\u0432\u0430\u043D\u0435 \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0442\u044F \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u043E HTTP 403. \u0426\u0435 \u0434\u043E\u0432\u0456\u0434\u043A\u043E\u0432\u0430 \u043E\u0441\u043D\u043E\u0432\u0430 \u0434\u043B\u044F \u043F\u043E\u044F\u0441\u043D\u0435\u043D\u043D\u044F \u043F\u043E\u0432\u0435\u0440\u043D\u0435\u043D\u043D\u044F \u0439 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0456\u0432 \u043F\u0440\u043E \u0434\u043E\u0445\u043E\u0434\u0438, \u0430 \u043D\u0435 \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u043A\u0430 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u043E\u0433\u043E \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u0435\u043D\u043D\u044F."}}]},"translationComplete":true}