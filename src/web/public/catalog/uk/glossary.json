[{"id":1,"termHe":"\u05EA\u05E2\u05D5\u05D3\u05EA \u05D6\u05D4\u05D5\u05EA","transliteration":"Te\u0027udat Zehut","meaning":"\u041F\u043E\u0441\u0432\u0456\u0434\u0447\u0435\u043D\u043D\u044F \u043E\u0441\u043E\u0431\u0438 (\u0442\u0435\u0443\u0434\u0430\u0442 \u0437\u0435\u0443\u0442). \u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442 \u0456\u0437 \u0434\u0435\u0432\u2019\u044F\u0442\u0438\u0437\u043D\u0430\u0447\u043D\u0438\u043C \u0456\u0434\u0435\u043D\u0442\u0438\u0444\u0456\u043A\u0430\u0446\u0456\u0439\u043D\u0438\u043C \u043D\u043E\u043C\u0435\u0440\u043E\u043C \u0434\u043B\u044F \u0437\u0432\u0435\u0440\u043D\u0435\u043D\u043D\u044F \u0434\u043E \u0443\u0441\u0442\u0430\u043D\u043E\u0432.","usageNote":null},{"id":2,"termHe":"\u05DE\u05E1\u05E4\u05E8 \u05EA\u05D9\u05E7","transliteration":"Mispar Tik","meaning":"\u041D\u043E\u043C\u0435\u0440 \u0441\u043F\u0440\u0430\u0432\u0438. \u0417\u0430\u0437\u043D\u0430\u0447\u0430\u0439\u0442\u0435 \u0439\u043E\u0433\u043E \u043F\u0456\u0434 \u0447\u0430\u0441 \u0437\u0432\u0435\u0440\u043D\u0435\u043D\u043D\u044F \u0449\u043E\u0434\u043E \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u043E\u0433\u043E \u043B\u0438\u0441\u0442\u0430 \u0447\u0438 \u043F\u0438\u0442\u0430\u043D\u043D\u044F.","usageNote":null},{"id":3,"termHe":"\u05D1\u05D9\u05D8\u05D5\u05D7 \u05DC\u05D0\u05D5\u05DE\u05D9","transliteration":"Bituach Leumi","meaning":"\u0411\u0456\u0442\u0443\u0430\u0445 \u041B\u0435\u0443\u043C\u0456. \u0406\u043D\u0441\u0442\u0438\u0442\u0443\u0442 \u043D\u0430\u0446\u0456\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0441\u0442\u0440\u0430\u0445\u0443\u0432\u0430\u043D\u043D\u044F \u0406\u0437\u0440\u0430\u0457\u043B\u044E, \u044F\u043A\u0438\u0439 \u0437\u0430\u0439\u043C\u0430\u0454\u0442\u044C\u0441\u044F \u0441\u043E\u0446\u0456\u0430\u043B\u044C\u043D\u0438\u043C \u0441\u0442\u0440\u0430\u0445\u0443\u0432\u0430\u043D\u043D\u044F\u043C \u0456 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0430\u043C\u0438.","usageNote":null},{"id":4,"termHe":"\u05DE\u05E1 \u05D4\u05DB\u05E0\u05E1\u05D4","transliteration":"Mas Hachnasa","meaning":"\u041F\u043E\u0434\u0430\u0442\u043E\u043A \u043D\u0430 \u0434\u043E\u0445\u0456\u0434. \u0422\u0430\u043A\u043E\u0436 \u043F\u043E\u0437\u043D\u0430\u0447\u0430\u0454 \u043F\u0456\u0434\u0440\u043E\u0437\u0434\u0456\u043B \u041F\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u043E\u0433\u043E \u0443\u043F\u0440\u0430\u0432\u043B\u0456\u043D\u043D\u044F, \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u043B\u044C\u043D\u0438\u0439 \u0437\u0430 \u0446\u0435\u0439 \u043F\u043E\u0434\u0430\u0442\u043E\u043A.","usageNote":null},{"id":5,"termHe":"\u05D3\u05E8\u05D9\u05E9\u05EA \u05EA\u05E9\u05DC\u05D5\u05DD","transliteration":"Drishat Tashlum","meaning":"\u0412\u0438\u043C\u043E\u0433\u0430 \u043F\u0440\u043E \u043E\u043F\u043B\u0430\u0442\u0443. \u041E\u0444\u0456\u0446\u0456\u0439\u043D\u0435 \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u0435\u043D\u043D\u044F \u043F\u0440\u043E \u0441\u043F\u043B\u0430\u0442\u0443 \u0437\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043E\u0457 \u0441\u0443\u043C\u0438 \u0443 \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0439 \u0441\u0442\u0440\u043E\u043A.","usageNote":null},{"id":6,"termHe":"\u05DE\u05D5\u05E2\u05D3 \u05D0\u05D7\u05E8\u05D5\u05DF","transliteration":"Moed Acharon","meaning":"\u041A\u0456\u043D\u0446\u0435\u0432\u0438\u0439 \u0441\u0442\u0440\u043E\u043A. \u041E\u0441\u0442\u0430\u043D\u043D\u044F \u0434\u0430\u0442\u0430 \u0434\u043B\u044F \u0434\u0456\u0457 \u0437 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430; \u043D\u0430\u0441\u043B\u0456\u0434\u043A\u0438 \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0443 \u0437\u0430\u043B\u0435\u0436\u0430\u0442\u044C \u0432\u0456\u0434 \u043F\u0440\u043E\u0446\u0435\u0434\u0443\u0440\u0438.","usageNote":null},{"id":7,"termHe":"\u05E2\u05E8\u05E2\u05D5\u05E8","transliteration":"Erur","meaning":"\u0410\u043F\u0435\u043B\u044F\u0446\u0456\u044F \u0430\u0431\u043E \u043E\u0441\u043A\u0430\u0440\u0436\u0435\u043D\u043D\u044F \u0440\u0456\u0448\u0435\u043D\u043D\u044F. \u0412\u0438\u0434 \u043F\u0440\u043E\u0446\u0435\u0434\u0443\u0440\u0438 \u0439 \u0441\u0442\u0440\u043E\u043A \u043F\u043E\u0434\u0430\u043D\u043D\u044F \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u044F\u0439\u0442\u0435 \u0432 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u043E\u043C\u0443 \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u0435\u043D\u043D\u0456; \u05D4\u05E9\u05D2\u05D4 \u0442\u0430 \u05E2\u05E8\u05E2\u05D5\u05E8 \u043C\u043E\u0436\u0443\u0442\u044C \u043E\u0437\u043D\u0430\u0447\u0430\u0442\u0438 \u0440\u0456\u0437\u043D\u0456 \u0435\u0442\u0430\u043F\u0438.","usageNote":"\u0417\u0431\u0435\u0440\u0435\u0436\u0456\u0442\u044C \u043A\u043E\u043F\u0456\u044E \u0437\u0432\u0435\u0440\u043D\u0435\u043D\u043D\u044F \u0442\u0430 \u043F\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043D\u043D\u044F \u043F\u043E\u0434\u0430\u043D\u043D\u044F. \u0423\u0442\u043E\u0447\u043D\u0456\u0442\u044C \u043E\u0444\u0456\u0446\u0456\u0439\u043D\u0438\u0439 \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u0456 \u0441\u0442\u0440\u043E\u043A \u0434\u043B\u044F \u0441\u0432\u043E\u0433\u043E \u0440\u0456\u0448\u0435\u043D\u043D\u044F."},{"id":8,"termHe":"\u05D0\u05D9\u05E9\u05D5\u05E8","transliteration":"Ishur","meaning":"\u041F\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043D\u043D\u044F \u0430\u0431\u043E \u0441\u0445\u0432\u0430\u043B\u0435\u043D\u043D\u044F. \u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442, \u0449\u043E \u043F\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0443\u0454 \u0441\u0442\u0430\u0442\u0443\u0441, \u043F\u0440\u0430\u0432\u043E \u0447\u0438 \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u0443 \u0434\u0456\u044E.","usageNote":null},{"id":9,"termHe":"\u05D4\u05E1\u05D1\u05E8 \u05E0\u05DC\u05D5\u05D5\u05D4","transliteration":"Hesber Nilve","meaning":"\u041F\u043E\u044F\u0441\u043D\u0435\u043D\u043D\u044F \u0434\u043E \u043B\u0438\u0441\u0442\u0430. \u0414\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0438\u0439 \u0442\u0435\u043A\u0441\u0442 \u0430\u0431\u043E \u0441\u0442\u043E\u0440\u0456\u043D\u043A\u0430 \u0437 \u043F\u043E\u044F\u0441\u043D\u0435\u043D\u043D\u044F\u043C \u0440\u043E\u0437\u0440\u0430\u0445\u0443\u043D\u043A\u0456\u0432 \u0456 \u0440\u0456\u0448\u0435\u043D\u044C.","usageNote":null},{"id":10,"termHe":"\u05E1\u05E2\u05D9\u05E3","transliteration":"Sa\u0027if","meaning":"\u041F\u0443\u043D\u043A\u0442 \u0430\u0431\u043E \u0440\u043E\u0437\u0434\u0456\u043B. \u041F\u0440\u043E\u043D\u0443\u043C\u0435\u0440\u043E\u0432\u0430\u043D\u0430 \u0447\u0430\u0441\u0442\u0438\u043D\u0430 \u0437\u0430\u043A\u043E\u043D\u0443 \u0447\u0438 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430.","usageNote":null},{"id":11,"termHe":"\u05EA\u05D5\u05E7\u05E3","transliteration":"Tokef","meaning":"\u0421\u0442\u0440\u043E\u043A \u0434\u0456\u0457. \u041F\u0435\u0440\u0456\u043E\u0434 \u0447\u0438\u043D\u043D\u043E\u0441\u0442\u0456 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430, \u0434\u043E\u0437\u0432\u043E\u043B\u0443 \u0447\u0438 \u0441\u0445\u0432\u0430\u043B\u0435\u043D\u043D\u044F.","usageNote":null},{"id":12,"termHe":"\u05E4\u05D8\u05D5\u05E8","transliteration":"Ptur","meaning":"\u0417\u0432\u0456\u043B\u044C\u043D\u0435\u043D\u043D\u044F. \u0417\u0432\u0456\u043B\u044C\u043D\u0435\u043D\u043D\u044F \u0432\u0456\u0434 \u043F\u0435\u0432\u043D\u043E\u0433\u043E \u043E\u0431\u043E\u0432\u2019\u044F\u0437\u043A\u0443, \u043F\u043E\u0434\u0430\u0442\u043A\u0443 \u0447\u0438 \u0437\u0431\u043E\u0440\u0443 \u0437\u0430 \u0434\u043E\u0442\u0440\u0438\u043C\u0430\u043D\u043D\u044F \u0443\u043C\u043E\u0432.","usageNote":null},{"id":13,"termHe":"\u05D4\u05D5\u05E6\u05D0\u05D4 \u05DC\u05E4\u05D5\u05E2\u05DC","transliteration":"Hotza\u0027a la-Po\u0027al","meaning":"\u0412\u0438\u043A\u043E\u043D\u0430\u0432\u0447\u0435 \u043F\u0440\u043E\u0432\